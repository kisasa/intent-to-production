# Copy this file to docker-compose.override.yml (gitignored — `docker
# compose` merges it with docker-compose.yml automatically) and fill in real
# values below. Compose merges `environment:` maps key by key, so only the
# keys being set need listing; everything else docker-compose.yml sets is
# untouched.
#
# webhook-listener and dispatch-worker each need a LINEAR_AGENT_API_KEY and
# GITHUB_TOKEN. They can be the same values or different bot accounts.
# dispatch-worker forwards its own ANTHROPIC_API_KEY, GITHUB_TOKEN and
# LINEAR_AGENT_API_KEY to every specialist it launches.

services:
  webhook-listener:
    environment:
      LINEAR_WEBHOOK_SECRET: ""
      LINEAR_AGENT_API_KEY: ""
      AGENT_USER_ID: ""
      GITHUB_TOKEN: ""
      ANTHROPIC_API_KEY: ""

  dispatch-worker:
    environment:
      GITHUB_TOKEN: ""
      LINEAR_AGENT_API_KEY: ""
      ANTHROPIC_API_KEY: ""
      # Optional — only if you changed the agent definitions or skills: your
      # fork, as org/name, and the branch to read them from.
      # FRAMEWORK_REPO: your-org/intent-to-production
      # FRAMEWORK_REF: main
      # Optional — e.g. {"you@example.com":"your-github-login"}
      REVIEWER_EMAIL_TO_GITHUB_LOGIN: ""
