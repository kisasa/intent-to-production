# Shared across docker-compose.yml's services — not any one package's own
# config. Copy to .env at the repo root (docker compose reads it
# automatically for ${VAR} interpolation).

# Required as of LocalStack's 2026-03 licensing change: the free, separately-
# distributed Community image was discontinued, and the single remaining
# image now requires an account + token even for the permanent free
# (non-commercial) tier. Sign up at https://app.localstack.cloud, generate a
# token, and set it here — there's no way around this from code.
LOCALSTACK_AUTH_TOKEN=
